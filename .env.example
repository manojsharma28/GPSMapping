# ZeroMQ publisher endpoint (the server running the GPS publisher)
ZMQ_ENDPOINT=tcp://127.0.0.1:5556
# Bind address for the included local publisher; use 127.0.0.1 to restrict it to this PC
PUBLISHER_BIND=tcp://0.0.0.0:5556
# HTTP input used by the included publisher and send:coordinate command
PUBLISHER_HTTP_HOST=127.0.0.1
PUBLISHER_HTTP_PORT=4175
PUBLISHER_HTTP_URL=http://127.0.0.1:4175/coordinates
# Driving route service base URL (OSRM-compatible)
ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving
# Optional ZeroMQ SUB topic prefix; empty subscribes to all messages
ZMQ_TOPIC=
# WebSocket endpoint exposed by the bridge
WS_PORT=4174
# Optional browser override; normally the default works
VITE_GPS_SOCKET_URL=ws://localhost:4174
