{
  "name": "gpsmapping",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,BRIDGE,PUBLISHER -c cyan,green,yellow \"vite\" \"tsx server/index.ts\" \"tsx server/publisher.ts\"",
    "dev:web": "vite",
    "dev:bridge": "tsx server/index.ts",
    "dev:publisher": "tsx server/publisher.ts",
    "send:coordinate": "tsx scripts/send-coordinate.ts",
    "build": "tsc -b && vite build",
    "check:bridge": "tsc --ignoreConfig --noEmit --target ES2023 --module NodeNext --moduleResolution NodeNext --types node --skipLibCheck server/index.ts server/publisher.ts scripts/send-coordinate.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "ws": "^8.22.0",
    "zeromq": "^6.8.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
